# For running on your own computer: copy to backend/.env and fill in. Never commit .env.
# On Railway, add these same names under your service's "Variables" tab instead.
PORT=3000

# ── Staff accounts (posting activities) ──
# The first owner account. Sign in at /login with this email and ADMIN_PASSWORD, then change the password.
# Changing ADMIN_PASSWORD here later resets that owner's password (use it if the password is forgotten).
ADMIN_EMAIL=info@chithufoundation.org
ADMIN_NAME=Chithu Foundation
ADMIN_PASSWORD=
# Random secret for sign-in cookies: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Optional "Sign in with Google": the OAuth Client ID from Google Cloud (see DEPLOY-RAILWAY.md)
GOOGLE_CLIENT_ID=
# Where posts and photos are saved. On Railway the attached Volume is used automatically.
# DATA_DIR=./data
# Public address used in share previews, e.g. https://www.chithufoundation.org (optional; detected automatically)
SITE_URL=

# Where contact-form messages are delivered
NOTIFY_EMAIL=info@chithufoundation.org

# ── Choose ONE way to send email ──
# Resend (Railway's recommendation; works on every Railway plan)
RESEND_API_KEY=
# Brevo (works on every Railway plan; only needs the sender email verified, no DNS)
BREVO_API_KEY=
# SMTP, e.g. Gmail app password. Blocked on Railway Free/Trial/Hobby plans; fine on your own computer.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Sender shown on the email. Resend without a verified domain: "Chithu Website <onboarding@resend.dev>".
# Brevo: an address you verified in Brevo, e.g. info@chithufoundation.org
MAIL_FROM=

# Optional: force a provider (resend | brevo | smtp | dryrun). Normally detected from the key you set.
EMAIL_PROVIDER=
# Testing without sending: prints the email in the terminal instead
MAIL_DRY_RUN=false

# Only if the website is hosted at a DIFFERENT address than this backend
ALLOWED_ORIGIN=
# Railway is detected automatically. Elsewhere behind a proxy/HTTPS, set these to true
TRUST_PROXY=false
HTTPS=false
