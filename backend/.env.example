# Copy to .env and fill in. Never commit .env.
PORT=3000

# ── Email (this is how messages reach the organisation) ──
# Where contact-form messages are delivered:
NOTIFY_EMAIL=info@chithufoundation.org
# The mail account the server sends FROM (an organisation mailbox). Examples:
#   Gmail / Google Workspace: smtp.gmail.com, port 587, user = full address, pass = an "App password"
#   Zoho: smtp.zoho.com   Brevo: smtp-relay.brevo.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Chithu Website <info@chithufoundation.org>"

# Testing without sending: prints the email in the terminal instead of sending it
MAIL_DRY_RUN=false

# ── Hosting ──
# Folder with the website files (default ../frontend)
# FRONTEND_DIR=../frontend
# Only if the website is hosted at a DIFFERENT address than this backend, e.g. https://chithufoundation.org
ALLOWED_ORIGIN=
# Set to true behind a proxy / load balancer (Render, Railway, Nginx...) so rate limits see real IPs
TRUST_PROXY=false
# Set to true when the site is served over HTTPS
HTTPS=false
