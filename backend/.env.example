# Copy to .env and fill in. Never commit .env.
PORT=3000

# Folder with the website files (default ../frontend). Leave as is unless you moved it.
# FRONTEND_DIR=../frontend
# Only if the website is hosted at a DIFFERENT address than this backend, e.g. https://chithufoundation.org
ALLOWED_ORIGIN=

# Staff inbox at /admin  (REQUIRED to enable the admin page; use a long passphrase)
ADMIN_PASSWORD=change-this-to-a-long-passphrase
# Random string used to sign login cookies (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=

# Set to true when served over HTTPS (production) so login cookies are Secure
COOKIE_SECURE=false
# Set to true if running behind a proxy/load balancer (Render, Railway, Nginx...) so rate limits see real IPs
TRUST_PROXY=false

# Optional: email a copy of each new message to the team
NOTIFY_EMAIL=info@chithufoundation.org
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Chithu Website <no-reply@chithufoundation.org>"
